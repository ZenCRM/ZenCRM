FLASK_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=
# Optional separate mailbox key (at least 32 characters). Keep stable after connecting accounts.
MAILBOX_ENCRYPTION_KEY=
# Fallback CRM origin; the address saved in Settings > Company takes precedence.
PUBLIC_BASE_URL=
TRUSTED_PROXY_HOPS=0
DATABASE_URL=sqlite:///zencrm.db

# Web Push: HTTPS required outside localhost. Keep the database (VAPID identity).
PUSH_ENABLED=true
VAPID_SUBJECT=mailto:admin@example.com

# Docker Compose only
# Domain served by Caddy with docker-compose.caddy.yml (HTTPS via Let's Encrypt).
ZENCRM_DOMAIN=
# Backup service: cron schedule, number of archives kept, host directory, time zone.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION=14
BACKUP_PATH=./backups
TZ=UTC

# Klucz produkcyjny BIR GUS (https://api.stat.gov.pl/Home/RegonApi)
GUS_API_KEY=
GUS_TEST_MODE=false

# Initial platform state; saved CRM setting takes precedence. Worker: plugins Compose profile.
PLUGINS_ENABLED=false
# Emergency server block, independent of the CRM switch.
PLUGINS_LOCKED=false

# Google Cloud OAuth client of type Web application, Drive API enabled.
# Callback: configured CRM origin + /api/plugins/google-drive/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
