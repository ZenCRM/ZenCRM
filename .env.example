# Web Push: HTTPS required outside localhost. Keep the database (VAPID identity).
PUSH_ENABLED=true
VAPID_SUBJECT=mailto:admin@example.com

# Klucz produkcyjny BIR GUS (https://api.stat.gov.pl/Home/RegonApi)
GUS_API_KEY=
GUS_TEST_MODE=false
